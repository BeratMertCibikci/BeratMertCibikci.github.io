---
// The whole one-page site. Rendered twice: / (English) and /fr/ (French).
import Base from '../layouts/Base.astro';
import Swarm from './Swarm.astro';
import ProjectVisual from './ProjectVisual.astro';
import { ui, profile, education, skills, t, type Lang } from '../i18n';
import { projects, otherProjects } from '../data/projects';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'en' ? 'fr' : 'en';
const otherHref = other === 'fr' ? '/fr/' : '/';

const contacts = [
	{ label: 'LinkedIn', href: profile.linkedin },
	{ label: 'GitHub', href: profile.github },
	{ label: 'CV (PDF)', href: profile.cv },
].filter((c) => c.href);
---

<Base
	lang={lang}
	title={`${profile.name} · ${lang === 'fr' ? 'IA distribuée' : 'Distributed AI'}`}
	description={t(ui.hero.subtitle, lang)}
>
	<header class="nav">
		<a href="#top" class="logo">~/berat-mert</a>
		<nav>
			<a href="#projects">{t(ui.nav.projects, lang)}</a>
			<a href="#about">{t(ui.nav.about, lang)}</a>
			<a href="#contact">{t(ui.nav.contact, lang)}</a>
			<span class="lang">
				[<span class="on">{lang}</span>|<a href={otherHref} hreflang={other} lang={other}>{other}</a>]
			</span>
			<button id="theme" class="theme" aria-label={lang === 'fr' ? 'Changer de thème' : 'Toggle theme'}>◐</button>
		</nav>
	</header>

	<section class="hero" id="top">
		<Swarm />
		<div class="hero-inner">
			<p class="status"><i></i>{t(ui.hero.status, lang)}</p>
			<h1>
				{t(ui.hero.title1, lang)}<br /><span>{t(ui.hero.title2, lang)}</span>
			</h1>
			<p class="sub">{t(ui.hero.subtitle, lang)}</p>
			<div class="cta">
				<a class="btn primary" href="#projects">{t(ui.hero.ctaProjects, lang)} ↓</a>
				<a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
				{profile.linkedin && <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
			</div>
		</div>
		<p class="hint">{t(ui.hero.hint, lang)}</p>
	</section>

	<main>
		<section id="projects" class="section">
			<h2><span class="num">01</span>{t(ui.projects.title, lang)}</h2>

			{projects.map((p, i) => (
				<article class:list={['project', { flip: i % 2 === 1 }]} id={p.id}>
					<div class="project-text">
						<p class="meta">{String(i + 1).padStart(2, '0')} · {p.year}</p>
						<h3>{p.title}</h3>
						<p class="tagline">{t(p.tagline, lang)}</p>
						<p class="role"><strong>{t(ui.projects.myRole, lang)}:</strong> {t(p.role, lang)}</p>
						<ul>
							{p.built.map((b) => <li>{t(b, lang)}</li>)}
						</ul>
						<div class="metrics">
							{p.metrics.map((m) => (
								<div class="metric">
									<span class="value">{m.value}</span>
									<span class="label">{t(m.label, lang)}</span>
								</div>
							))}
						</div>
						<div class="foot">
							<div class="stack">{p.stack.map((s) => <span>{s}</span>)}</div>
							{p.repo ? (
								<a class="link" href={p.repo} target="_blank" rel="noopener">{t(ui.projects.code, lang)} ↗</a>
							) : (
								<span class="private">{t(ui.projects.privateRepo, lang)}</span>
							)}
						</div>
					</div>
					{p.visual && <ProjectVisual kind={p.visual} lang={lang} />}
				</article>
			))}

			<h3 class="other-title">{t(ui.projects.otherTitle, lang)}</h3>
			<ul class="other">
				{otherProjects.map((o) => (
					<li>
						<span class="o-title">{o.title}</span>
						<span class="o-text">{t(o.text, lang)}</span>
						<span class="o-stack">{o.stack}</span>
					</li>
				))}
			</ul>
		</section>

		<section id="about" class="section">
			<h2><span class="num">02</span>{t(ui.about.title, lang)}</h2>
			<div class="about">
				<p class="about-text">{t(ui.about.text, lang)}</p>
				<div>
					<h3 class="small">{t(ui.about.education, lang)}</h3>
					<ul class="timeline">
						{education.map((e) => (
							<li>
								<span class="years">{e.years}</span>
								<span><strong>{t(e.title, lang)}</strong><br />{e.place}</span>
							</li>
						))}
					</ul>
					<h3 class="small">{t(ui.about.skills, lang)}</h3>
					{skills.map((s) => (
						<div class="skill-row">
							<span class="years">{t(s.group, lang)}</span>
							<div class="stack">{s.items.map((it) => <span>{typeof it === 'string' ? it : t(it, lang)}</span>)}</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="contact" class="section contact">
			<h2><span class="num">03</span>{t(ui.contact.title, lang)}</h2>
			<p>{t(ui.contact.text, lang)}</p>
			{profile.email && (
				<div class="email">
					<a href={`mailto:${profile.email}`}>{profile.email}</a>
					<button
						id="copy-email"
						data-email={profile.email}
						data-done={t(ui.contact.copied, lang)}
					>{t(ui.contact.copy, lang)}</button>
				</div>
			)}
			<div class="cta">
				{contacts.map((c) => (
					<a class="btn" href={c.href} target="_blank" rel="noopener">{c.label} ↗</a>
				))}
			</div>
		</section>
	</main>

	<footer>
		<span>© 2026 {profile.name}</span>
		<span>{t(ui.footer, lang)}</span>
	</footer>
</Base>

<script>
	// Theme toggle: dark ↔ light, remembered in localStorage
	const root = document.documentElement;
	document.getElementById('theme')!.addEventListener('click', () => {
		const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		const next = current === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		document.dispatchEvent(new Event('themechange'));
	});

	// Copy the email address to the clipboard
	const copy = document.getElementById('copy-email');
	copy?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(copy.dataset.email!);
			const label = copy.textContent;
			copy.textContent = copy.dataset.done!;
			setTimeout(() => (copy.textContent = label), 1600);
		} catch {}
	});
</script>

<style>
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 18px max(16px, calc((100vw - var(--max)) / 2));
		font-family: var(--mono);
		font-size: 13px;
		color: var(--muted);
		background: color-mix(in srgb, var(--bg) 75%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.nav a { text-decoration: none; }
	.nav a:hover { color: var(--text); }
	.logo { color: var(--text); }
	.nav nav { display: flex; align-items: center; gap: 20px; }
	.lang .on { color: var(--accent); }
	.theme {
		background: none;
		border: 1px solid var(--border-strong);
		color: var(--text);
		border-radius: 6px;
		width: 28px;
		height: 28px;
		cursor: pointer;
		font-size: 14px;
	}

	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: center;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
	}
	.hero-inner {
		position: relative;
		width: 100%;
		max-width: var(--max);
		margin: 0 auto;
		padding: 120px 16px 80px;
		pointer-events: none;
	}
	.hero-inner a { pointer-events: auto; }
	.status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--muted);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		padding: 4px 12px;
		margin: 0 0 28px;
		background: var(--bg);
	}
	.status i {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 2s infinite;
	}
	@keyframes pulse { 50% { opacity: 0.3; } }
	h1 {
		font-size: clamp(44px, 8vw, 96px);
		line-height: 1.02;
		letter-spacing: -0.035em;
		font-weight: 600;
		margin: 0 0 24px;
	}
	h1 span { color: var(--accent); }
	.sub {
		max-width: 560px;
		font-size: 18px;
		color: var(--muted);
		margin: 0 0 32px;
	}
	.hint {
		position: absolute;
		bottom: 20px;
		left: 50%;
		transform: translateX(-50%);
		font-family: var(--mono);
		font-size: 11px;
		color: var(--muted);
		margin: 0;
		pointer-events: none;
		white-space: nowrap;
	}

	.cta { display: flex; flex-wrap: wrap; gap: 10px; }
	.btn {
		display: inline-block;
		padding: 10px 18px;
		border-radius: 8px;
		border: 1px solid var(--border-strong);
		background: var(--bg);
		text-decoration: none;
		font-size: 14px;
		font-weight: 500;
		transition: border-color 0.15s, transform 0.15s;
	}
	.btn:hover { border-color: var(--accent); transform: translateY(-1px); }
	.btn.primary { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }

	main { max-width: var(--max); margin: 0 auto; padding: 0 16px; }
	.section { padding: 110px 0 40px; scroll-margin-top: 40px; }
	h2 {
		font-size: clamp(28px, 4vw, 40px);
		letter-spacing: -0.02em;
		font-weight: 600;
		margin: 0 0 48px;
	}
	.num {
		font-family: var(--mono);
		font-size: 14px;
		color: var(--accent);
		margin-right: 14px;
		vertical-align: middle;
	}

	.project {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: 48px;
		align-items: center;
		padding: 48px 0;
		border-top: 1px solid var(--border);
	}
	.project.flip .project-text { order: 2; }
	.meta { font-family: var(--mono); font-size: 12px; color: var(--muted); margin: 0 0 6px; }
	h3 { font-size: 28px; letter-spacing: -0.02em; font-weight: 600; margin: 0 0 10px; }
	.tagline { font-size: 18px; margin: 0 0 14px; }
	.role { color: var(--muted); margin: 0 0 14px; font-size: 15px; }
	.role strong { color: var(--text); font-weight: 500; }
	.project ul { margin: 0 0 22px; padding-left: 18px; color: var(--muted); font-size: 15px; }
	.project li { margin-bottom: 4px; }
	.project li::marker { color: var(--accent); }

	.metrics { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 22px; }
	.metric {
		display: flex;
		flex-direction: column;
		padding: 10px 14px;
		border-radius: 8px;
		background: var(--surface);
		border: 1px solid var(--border);
		min-width: 120px;
	}
	.value { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
	.label { font-size: 12px; color: var(--muted); }

	.foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
	.stack { display: flex; flex-wrap: wrap; gap: 6px; }
	.stack span {
		font-family: var(--mono);
		font-size: 11px;
		padding: 3px 8px;
		border-radius: 4px;
		background: var(--surface-2);
		color: var(--text);
	}
	.link { color: var(--accent); font-weight: 500; font-size: 14px; }
	.private { font-family: var(--mono); font-size: 11px; color: var(--muted); }

	.other-title { font-size: 18px; margin: 40px 0 12px; }
	.other { list-style: none; padding: 0; margin: 0; }
	.other li {
		display: grid;
		grid-template-columns: 200px 1fr auto;
		gap: 16px;
		padding: 14px 0;
		border-top: 1px solid var(--border);
		font-size: 15px;
	}
	.o-title { font-weight: 500; }
	.o-text { color: var(--muted); }
	.o-stack { font-family: var(--mono); font-size: 12px; color: var(--muted); }

	.about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
	.about-text { font-size: 20px; line-height: 1.55; margin: 0; }
	.small {
		font-size: 13px;
		font-family: var(--mono);
		font-weight: 400;
		color: var(--muted);
		margin: 0 0 12px;
		letter-spacing: 0;
	}
	.timeline { list-style: none; padding: 0; margin: 0 0 32px; }
	.timeline li, .skill-row {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 14px;
		padding: 10px 0;
		border-top: 1px solid var(--border);
		font-size: 15px;
	}
	.timeline strong { font-weight: 500; }
	.years { font-family: var(--mono); font-size: 12px; color: var(--muted); padding-top: 3px; }

	.contact p { font-size: 18px; color: var(--muted); max-width: 560px; margin: 0 0 24px; }
	.email {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px;
		margin-bottom: 24px;
	}
	.email a {
		font-size: clamp(22px, 4vw, 36px);
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
		background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0 2px;
		transition: background-size 0.25s, color 0.15s;
		overflow-wrap: anywhere;
	}
	.email a:hover { color: var(--accent); background-size: 100% 2px; }
	.email button {
		font-family: var(--mono);
		font-size: 12px;
		color: var(--muted);
		background: none;
		border: 1px solid var(--border-strong);
		border-radius: 6px;
		padding: 5px 10px;
		cursor: pointer;
	}
	.email button:hover { color: var(--text); border-color: var(--accent); }

	footer {
		max-width: var(--max);
		margin: 80px auto 0;
		padding: 24px 16px 40px;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px;
		border-top: 1px solid var(--border);
		font-family: var(--mono);
		font-size: 12px;
		color: var(--muted);
	}

	@media (max-width: 800px) {
		.nav nav a:not(.lang a) { display: none; }
		.project, .about { grid-template-columns: minmax(0, 1fr); gap: 28px; }
		.project.flip .project-text { order: 0; }
		.other li { grid-template-columns: 1fr; gap: 2px; }
		.section { padding-top: 80px; }
	}
</style>
