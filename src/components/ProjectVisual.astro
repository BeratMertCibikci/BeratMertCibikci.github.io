---
// Small illustration on each project card (no screenshots needed).
import type { Lang } from '../i18n';
import { winRates } from '../data/projects';

interface Props {
	kind: 'winrate' | 'sokoban' | 'chat' | 'boundary';
	lang: Lang;
}
const { kind, lang } = Astro.props;
const fr = lang === 'fr';

// Sokoban: first level of the Minicosmos set
const level = ['  #####', '###   #', '# $ # ##', '# #  . #', '#    # #', '## #   #', ' #@  ###', ' #####'];
const cols = Math.max(...level.map((r) => r.length));

// Two moons dataset (same shape as sklearn's make_moons), fixed seed so the picture never changes
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const sx = (x: number) => 10 + ((x + 1.3) / 3.6) * 240; // data x in [-1.3, 2.3] → svg 10..250
const sy = (y: number) => 120 - ((y + 0.9) / 2.2) * 110; // data y in [-0.9, 1.3] → svg 120..10
const moons = Array.from({ length: 90 }, (_, i) => {
	const top = i % 2 === 0;
	const a = rand() * Math.PI;
	const x = (top ? Math.cos(a) : 1 - Math.cos(a)) + (rand() - 0.5) * 0.16;
	const y = (top ? Math.sin(a) : 0.5 - Math.sin(a)) + (rand() - 0.5) * 0.16;
	return { x: sx(x), y: sy(y), top };
});
// A boundary that weaves between the moons, drawn as a smooth Catmull-Rom curve
const pts = [[-1.3, -0.35], [-0.5, 0.3], [0, 0.75], [0.5, 0.25], [1, -0.25], [1.5, 0.15], [2.3, 0.95]].map(([x, y]) => [sx(x), sy(y)]);
let boundary = `M ${pts[0][0]} ${pts[0][1]}`;
for (let i = 0; i < pts.length - 1; i++) {
	const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
	boundary += ` C ${p1[0] + (p2[0] - p0[0]) / 6} ${p1[1] + (p2[1] - p0[1]) / 6}, ${p2[0] - (p3[0] - p1[0]) / 6} ${p2[1] - (p3[1] - p1[1]) / 6}, ${p2[0]} ${p2[1]}`;
}
---

{kind === 'winrate' && (
	<figure class="viz">
		<img class="shot" src="/images/mr-jack-board.jpg" width="1280" height="822" loading="lazy"
			alt={fr ? 'Plateau de jeu de Mr. Jack Pocket' : 'Mr. Jack Pocket game board'} />
		<figcaption>{fr ? 'IA contre IA · 40 parties par niveau' : 'AI vs AI · 40 games per level'}</figcaption>
		{winRates.map((r) => (
			<div class="bar-row">
				<span class="bar-label">{r.level}</span>
				<div class="bar">
					<div class="bar-a" style={`width:${r.investigator}%`}>{r.investigator}%</div>
					<div class="bar-b">{100 - r.investigator}%</div>
				</div>
			</div>
		))}
		<div class="legend">
			<span><i class="dot a"></i>{fr ? 'Enquêteur' : 'Investigator'}</span>
			<span><i class="dot b"></i>Jack</span>
		</div>
	</figure>
)}

{kind === 'sokoban' && (
	<figure class="viz">
		<figcaption>Minicosmos 01</figcaption>
		<div class="soko" style={`grid-template-columns:repeat(${cols},1fr)`}>
			{level.flatMap((row) =>
				[...row.padEnd(cols, ' ')].map((c) => (
					<span class={{ '#': 'w', $: 'box', '.': 'goal', '@': 'me', ' ': 'f' }[c]}></span>
				)),
			)}
		</div>
	</figure>
)}

{kind === 'chat' && (
	<figure class="viz chat">
		<div class="msg me">{fr ? 'Déplace le TD de jeudi à 14h' : "Move Thursday's lab to 2 pm"}</div>
		<div class="tool">› {fr ? "lit l'agenda" : 'reading calendar'} ✓</div>
		<div class="card">
			<p>{fr ? 'Modifier « TD IA » → jeu. 14:00 ?' : 'Update “AI lab” → Thu 2:00 pm?'}</p>
			<div class="btns"><span class="ok">{fr ? 'valider' : 'approve'}</span><span>{fr ? 'refuser' : 'reject'}</span></div>
		</div>
	</figure>
)}

{kind === 'boundary' && (
	<figure class="viz">
		<figcaption>{fr ? 'Frontière apprise par le MLP' : 'Decision boundary learned by the MLP'}</figcaption>
		<svg viewBox="0 0 260 130" role="img" aria-label="Two moons dataset split by a curved boundary">
			<path class="boundary" d={boundary} />
			{moons.map((p) => <circle cx={p.x} cy={p.y} r="2.6" class={p.top ? 'pa' : 'pb'} />)}
		</svg>
	</figure>
)}

<style>
	.viz {
		margin: 0;
		padding: 18px;
		border-radius: 12px;
		background: var(--surface);
		border: 1px solid var(--border);
		font-size: 12px;
		color: var(--muted);
	}
	.shot {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
		margin-bottom: 16px;
	}
	figcaption {
		font-family: var(--mono);
		margin-bottom: 12px;
	}
	.bar-row {
		display: grid;
		grid-template-columns: 56px 1fr;
		align-items: center;
		gap: 10px;
		margin-bottom: 8px;
	}
	.bar {
		display: flex;
		height: 22px;
		border-radius: 6px;
		overflow: hidden;
		font-family: var(--mono);
		font-size: 11px;
	}
	.bar > div {
		display: flex;
		align-items: center;
		padding: 0 8px;
	}
	.bar-a { background: var(--accent); color: var(--on-accent); }
	.bar-b { flex: 1; justify-content: flex-end; background: var(--surface-2); color: var(--text); }
	.legend { display: flex; gap: 16px; margin-top: 12px; }
	.dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
	.dot.a { background: var(--accent); }
	.dot.b { background: var(--surface-2); border: 1px solid var(--border-strong); }

	.soko { display: grid; gap: 2px; max-width: 220px; }
	.soko span { aspect-ratio: 1; border-radius: 3px; }
	.soko .w { background: var(--surface-2); }
	.soko .goal { box-shadow: inset 0 0 0 2px var(--accent); }
	.soko .box { background: var(--warm); }
	.soko .me { background: var(--accent); border-radius: 50%; }

	.chat { display: flex; flex-direction: column; gap: 8px; font-size: 13px; }
	.msg.me {
		align-self: flex-end;
		background: var(--surface-2);
		color: var(--text);
		padding: 7px 12px;
		border-radius: 12px 12px 2px 12px;
	}
	.tool { font-family: var(--mono); font-size: 11px; }
	.card { border: 1px solid var(--accent); border-radius: 10px; padding: 10px 12px; color: var(--text); }
	.card p { margin: 0 0 8px; }
	.btns { display: flex; gap: 8px; font-size: 12px; }
	.btns span { padding: 3px 10px; border-radius: 6px; border: 1px solid var(--border-strong); }
	.btns .ok { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }

	svg { width: 100%; height: auto; display: block; }
	.boundary { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 4; }
	.pa { fill: var(--accent); }
	.pb { fill: var(--warm); }
</style>
